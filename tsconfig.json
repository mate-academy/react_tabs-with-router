{
  "include": ["src"],
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": false,
    "types": ["node", "cypress"],
    "target": "ES2015",
    "moduleResolution": "node",
    "lib": ["ES2015", "DOM"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
